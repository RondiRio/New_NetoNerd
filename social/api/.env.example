# Copie para .env e preencha — NUNCA commite o .env

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agenda_creche
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=365

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Expo Push Notifications
EXPO_ACCESS_TOKEN=

# Configurações gerais
APP_ENV=development
APP_URL=http://localhost/agenda_elsacorradine/api

# CORS — domínios web autorizados a chamar esta API com credentials,
# separados por vírgula (ex: https://app.exemplo.com,https://admin.exemplo.com).
# Apps mobile (Expo/React Native) não enviam Origin e não são afetados por
# esta lista — usam o Bearer token normalmente.
APP_CORS_ORIGINS=
